# Single source of truth for base-image versions.
#
# Consumers:
#   - Containerfile keeps matching ARG defaults (so a local `podman build .`
#     works offline); CI overrides them with --build-arg from this file.
#   - The container workflow loads these into $GITHUB_ENV (a "Load build
#     versions" step) and passes them as container build args.
#
# Keep the Containerfile ARG defaults equal to the values here.
ALPINE_VERSION=3.23
RUST_VERSION=1
